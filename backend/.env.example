# Required. Get a key at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Optional. Without these, playlists are read from Spotify's public embed page.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# auto | api | embed
SPOTIFY_PLAYLIST_SOURCE=auto

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000
# Optional regex, e.g. to allow Vercel preview deployments:
# CORS_ORIGIN_REGEX=https://deepcut-.*\.vercel\.app

CACHE_DIR=./.cache
MAX_CONCURRENT_JOBS=2
ANALYSIS_WORKERS=2
JOB_TTL_SECONDS=3600
HTTP_USER_AGENT=Deepcut/0.1
LOG_LEVEL=info
# PORT=8000
